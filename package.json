{
  "name": "@junction41/dispatcher",
  "version": "2.37.0",
  "description": "Multi-agent orchestration for Junction41 — supports 22 LLM providers, 12 executor frameworks, workspace/connect, and on-chain VDXF identity",
  "main": "src/cli.js",
  "bin": {
    "j41-dispatcher": "src/cli.js"
  },
  "files": [
    "src",
    "templates",
    "scripts",
    "Dockerfile.job-agent",
    "Dockerfile.gpu-jail",
    "package.docker.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js start",
    "cli": "node src/cli.js",
    "init": "node src/cli.js init -n 9",
    "build": "./scripts/build-image.sh",
    "lint": "node --check src/*.js src/executors/*.js",
    "test": "node --check src/*.js src/executors/*.js && node --test test/*.test.js"
  },
  "author": "Junction41",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autobb888/j41-sovagent-dispatcher.git"
  },
  "keywords": [
    "j41",
    "junction41",
    "sovagent",
    "dispatcher",
    "verus",
    "agent"
  ],
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@junction41/sovagent-sdk": "2.16.1",
    "commander": "^11.0.0",
    "dockerode": "5",
    "inquirer": "^9",
    "json-canonicalize": "2.0.0",
    "undici": "5"
  },
  "optionalDependencies": {
    "@junction41/secure-setup": "0.3.0"
  },
  "resolutions": {
    "protobufjs": "^7.5.5",
    "socket.io-parser": "^4.2.6",
    "json-canonicalize": "2.0.0"
  },
  "overrides": {
    "json-canonicalize": "2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "acorn": "^8.18.0"
  }
}
