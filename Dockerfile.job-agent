# J41 Job Agent Image (Pre-baked)
# This image has all dependencies pre-installed for fast container startup

FROM node:22-slim AS base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ─────────────────────────────────────────
# PRE-INSTALL DEPENDENCIES (baked into image)
# ─────────────────────────────────────────

# Install dependencies. By default the SDK is pulled from npm via the pin in
# package.docker.json. For local-SDK builds (J41_USE_LOCAL_SDK=1 in
# scripts/build-image.sh), the script swaps the SDK dep to file:./local-sdk.tgz
# and stages the tarball; the unconditional COPY below picks up the placeholder
# in the default case and the real tarball in the override case.
COPY package.docker.json ./package.json
COPY local-sdk.tgz ./local-sdk.tgz
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force && rm -f /app/local-sdk.tgz

# Copy executor source files
COPY src/executors ./executors

# Copy logger
COPY src/logger.js ./
COPY src/config-loader.js ./
# Prompt-injection taint helper (required by the executors) — wraps the
# vendored scanContext from @junction41/sovagent-sdk.
COPY src/sovguard-context.js ./

# Copy runtime scripts (baked into image)
COPY src/job-agent.js ./
COPY src/sign-attestation.js ./
COPY src/container-entry.sh ./
# Broker mode (J41_SIGNING_BROKER=1) — container-side file-channel client +
# unified signer surface. Both are required for `job-agent.js` to start; the
# defensive guard in job-agent.js refuses to run if broker mode is on but
# these aren't present.
COPY src/sign-channel-client.js ./
COPY src/job-signer.js ./
RUN chmod +x container-entry.sh

# ─────────────────────────────────────────
# SECURITY HARDENING
# ─────────────────────────────────────────

# Create non-root user for running agent
RUN groupadd -r j41-agent && useradd -r -g j41-agent j41-agent

# Set permissions
RUN chown -R j41-agent:j41-agent /app

# Drop to non-root
USER j41-agent

# ─────────────────────────────────────────
# CONTAINER CONFIG
# ─────────────────────────────────────────

# Environment (overridden at runtime)
ENV J41_API_URL=https://api.junction41.io
ENV NODE_ENV=production

# Health check — verify Node process is responsive
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD node -e "setTimeout(() => { process.exit(0); }, 1000).unref();" || exit 1

# Start job agent
ENTRYPOINT ["node", "job-agent.js"]
