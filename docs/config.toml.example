# ~/.j41/dispatcher/config.toml
# Mode 0600 (set automatically). Edited by `j41-dispatcher dashboard` or by hand.
# Process env vars (J41_API_URL, etc.) override per-key for ops convenience.
# See src/config-loader.js → ENV_OVERRIDES for the full override table.

[platform]
api_url = "https://api.junction41.io"
network = "verustest"  # or "verus" for mainnet

[runtime]
max_concurrent = 0          # 0 = unlimited
keep_containers = false
require_finalize = false
skip_status_check = false
allow_local_upstream = false  # SSRF guard — only enable on dev boxes
health_port = 9842          # open /health + /metrics for monitor-room probes
control_api_port = 9843     # token-gated headless control API (WP-D1/D2)
webhook_url = ""            # public URL for event-driven mode (cloudflared etc.)

[logging]
level = "info"              # debug, info, warn, error
format = "text"             # text, json (for log aggregators)

[executor]
type = "local-llm"          # local-llm, webhook, langgraph, langserve, a2a, mcp
url = ""
auth = ""
timeout_ms = 60000
mcp_command = ""
mcp_url = ""
max_tool_rounds = 10

[llm]
provider = ""               # EXACT LLM_PRESETS key: openai, claude-sonnet, gemini, grok, ...
                            # ("claude" alone is NOT a preset — the Claude presets are
                            # claude-opus / claude-sonnet / claude-haiku)
model = ""
base_url = ""               # override preset.baseUrl
api_key = ""                # generic fallback if provider_keys.<preset> empty

[provider_keys]
# ⚠️ Keyed by the EXACT preset name set in [llm] provider (or a per-agent
# llmProvider) — NOT by provider company. The dispatcher and the preflight
# LLM probe both resolve the key as provider_keys.<preset-name>, then fall
# back to llm.api_key. A key stored under any other name is read by NOTHING.
# Symptom of a mis-keyed entry: the preflight probe fails auth and every job
# is declined as "LLM unavailable" while you hold a valid key.
#
# Variant presets each need their own entry (openai-mini does NOT read
# provider_keys.openai) — or set llm.api_key as the shared fallback.
#
# Migrating from a legacy .env? The auto-migration wrote ANTHROPIC_API_KEY /
# GOOGLE_API_KEY / XAI_API_KEY into provider_keys.anthropic / google / xai —
# names no preset reads. Move those values to the preset name you actually
# use: claude-* presets take an OpenRouter key, gemini* takes the Google key,
# grok takes the xAI key.
#
# Read by the dispatcher when spawning job containers — never enters the
# dispatcher's own process.env.
openai = ""                 # openai-mini / openai-o3 need their own entries
claude-sonnet = ""          # claude-* presets route via OpenRouter — use an OpenRouter key
claude-opus = ""
claude-haiku = ""
gemini = ""                 # Google AI Studio key; gemini-flash needs its own entry
grok = ""                   # xAI key
groq = ""
deepseek = ""
mistral = ""
together = ""
fireworks = ""
nvidia = ""
cohere = ""
perplexity = ""
openrouter = ""
kimi = ""                   # kimi-nvidia needs its own entry
azure = ""

[proxy]
upstream_timeout_ms = 60000     # raise to 300000 for long local-LLM queries
estimated_input_tokens = 4000   # fallback when token counter not available
estimated_output_tokens = 2000  # fallback when no max_tokens in request body
suggested_topup_vrsc = 10       # X-J41-Credit-SuggestedTopup header default

[deposit]
poll_interval_ms = 60000        # how often to scan for new VRSC deposits

[health]
poll_interval_ms = 60000        # how often upstream-health pings each agent's upstream

[webhook]
max_body_bytes = 1048576        # 1 MiB inbound body cap

[retry]
rate_limit_backoff_multiplier = 3   # multiplier on baseDelayMs for HTTP 429 responses

[budget]
# Token budget enforcement (WP-D4). Set vrsc_usd_rate — until it's > 0, jobs
# run on fallback_token_budget and extensions are never auto-priced.
vrsc_usd_rate = 0               # USD per VRSC (0 = unset → fail closed)
rate_max_age_ms = 86400000      # a rate older than this counts as missing (24h)
spend_fraction = 0.6            # share of job value spendable on LLM cost
fallback_token_budget = 50000   # budget when the job can't be priced
warning_percent = 80            # budget % that triggers an extension request
extension_wait_ms = 600000      # exhausted + unapproved this long → deliver partial

[fee_sweep]
# Agents pay on-chain fees (~0.0001/write) from their R-address, but job
# payments land at their i-address — so the R-address only drains and the agent
# eventually goes silent on-chain while holding unswept earnings. This sweeps
# i-address -> R-address automatically. It is self-funding: the sweep pays its
# own fee out of the inputs it moves, so it works at a zero R-address balance.
enabled = true                  # on by default; the failure it prevents is silent
floor_writes = 100              # sweep when the tank affords fewer writes than this
interval_ms = 1800000           # how often to check (30 min). NOTE: the CLI flag
                                # --fee-sweep-interval takes MINUTES; this takes ms.

[jailbox]
# The "agent works inside the buyer's environment" sandbox (legacy
# "workspace") is PARKED in favour of deliver-and-review — see
# JAILBOX_PARKED.md in the repo root. Default OFF: the dispatcher refuses to
# start a jailbox session unless you opt back in here or with
# JAILBOX_ENABLED=1 (the env override accepts ONLY the literal 1 — "true"
# is treated as unset).
enabled = false

[debug]
chat = false                # enables [chat] event log when true (privacy-sensitive)
